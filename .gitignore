# Cache local de HTML crudo.
# Es reproducible (se vuelve a descargar bajo demanda), asi que no se versiona.
cache/

# Entornos
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# El dataset SI se versiona: es el resultado del proyecto y hace falta para
# consultar los datos sin esperar 35 minutos de descarga. Se regenera con
# `python -m goya_scraper`; si cambia, el commit lo deja explicito.
# La base de datos NO: es una proyeccion reconstruible con
# `python -m goya_scraper.import_db`. Los ficheros WAL tampoco se versionan.
data/goya.db
*.db-wal
*.db-shm

